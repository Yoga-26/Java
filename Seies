public class Series {
	void series1() {
		for ( int i =2; i <=16; i=i+2) {
			System.out.println( i);
		}
	}

	void series2() {
		 for ( int i =50; i>=0; i= i-10) {
			 System.out.print(i);
		 }
	}
	public static void main(String[] args) {
		Series obj =  new Series() ;
		 System.out.println("Series1:");
		 obj.series1();
		 System.out.println();
		 
		 System.out.println("Series2:");
		 obj.series2();
		 
	
		
	}

